    <title>protonvpn (Install)</title>
    <authors>ProtonVPN AG</authors>
    <projectUrl>https://protonvpn.com/</projectUrl>
    <iconUrl>https://cdn.statically.io/gh/artfulbodger/chocolatey-packages@master/icons/protonvpn.png</iconUrl>
